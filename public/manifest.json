{
  "manifest_version": 3,
  "name": "Auri Extension",
  "version": "0.1.0",
  "description": "Leve o contexto da página atual ao Auri, sob seu comando.",
  "permissions": ["activeTab", "scripting", "storage"],
  "icons": {
    "16": "icons/auri-16.png",
    "32": "icons/auri-32.png",
    "48": "icons/auri-48.png",
    "128": "icons/auri-128.png"
  },
  "action": {
    "default_title": "Abrir Auri",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/auri-16.png",
      "32": "icons/auri-32.png"
    }
  },
  "background": {
    "service_worker": "assets/service-worker.js",
    "type": "module"
  }
}
