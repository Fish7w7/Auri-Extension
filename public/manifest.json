{
  "manifest_version": 3,
  "name": "Auri",
  "version": "0.1.0",
  "description": "Conecte suas leituras no navegador à sua biblioteca local do Auri Desktop.",
  "permissions": ["activeTab", "scripting", "nativeMessaging"],
  "icons": {
    "16": "icons/auri-16.png",
    "32": "icons/auri-32.png",
    "48": "icons/auri-48.png",
    "128": "icons/auri-128.png"
  },
  "action": {
    "default_title": "Abrir Auri",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/auri-16.png",
      "32": "icons/auri-32.png"
    }
  }
}
